node_modules/
.worktrees/
# also match a node_modules *symlink* (agent worktrees link to the main install)
node_modules
*.log

# editor / OS
.DS_Store
.vscode/
.idea/

# build output — the published artifact (tsc -p tsconfig.build.json); tests build it on demand
dist/
# scripts/clean-build.mjs's scratch names, mid-swap or after a killed build
dist.tmp/
dist.stale-*/
*.tsbuildinfo

# pnpm writes this locally with unresolved `allowBuilds` placeholders; it is
# machine state, not project config (this repo has no workspaces).
pnpm-workspace.yaml

# agent worktrees live inside the repo but are never part of it
.claude/worktrees/

.superpowers/
