{
  // Emit config only — everything shared lives in tsconfig.json (extends).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Source imports use ".ts" specifiers; this rewrite is what makes dist/
    // valid ESM. Removing it breaks installed users only — the dev checkout
    // keeps working. Guarded by __tests__/pack.test.ts.
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist",
    "declaration": false,
    "sourceMap": false,
    "removeComments": true,
    "noEmit": false
  }
}
