{
  "mcpServers": {
    "predexec": {
      "command": "npx",
      "args": [
        "-y",
        "--package=predexec@0.6.0",
        "predexec-mcp",
        "--host",
        "codex"
      ],
      "env_vars": [
        "CODEX_HOME",
        "PREDEXEC_READONLY_HEADS",
        "PREDEXEC_ALLOW_SCRIPTS",
        "XDG_CONFIG_HOME"
      ]
    }
  }
}
