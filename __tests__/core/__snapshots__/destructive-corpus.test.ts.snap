  "{}": "unknown command {}",
  "}": null,
  "}\`": "complex shell syntax",
  "}}": "unknown command }}",
  "é": "unknown command é",
  "…[truncated": "unknown command …[truncated",
  "…[truncated]": "dynamic command name",
  "→ false": "unknown command →",
  "→ true (matched)": "unknown command →",
  "⚠ Output truncated": "unknown command ⚠",
}
`;
