{
  "name": "predexec",
  "version": "0.3.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "description": "Predictive execution: collapse an adaptive multi-level tool sequence into a single model round-trip via a deterministic plan tree. pi coding agent extension / opencode plugin / Claude Code MCP server.",
  "author": "FuriousZen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FuriousZen/predexec.git"
  },
  "homepage": "https://github.com/FuriousZen/predexec#readme",
  "bugs": "https://github.com/FuriousZen/predexec/issues",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "pi-package"
  ],
  "main": "dist/.opencode/plugins/predexec.js",
  "bin": {
    "predexec": "./bin/predexec.mjs",
    "predexec-mcp": "./bin/predexec-mcp.mjs"
  },
  "files": [
    "dist",
    "bin",
    ".pi/skills",
    "skills",
    "configs",
    ".claude-plugin",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./dist/.pi/extension/index.js"
    ],
    "skills": [
      "./.pi/skills"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.82.1",
    "@types/node": "24.12.4",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.2.0"
  }
}
